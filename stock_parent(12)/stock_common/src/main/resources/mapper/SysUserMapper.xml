    <update id="updateById">
        UPDATE sys_user
        SET username = #{sysUser.username},
              phone = #{sysUser.phone},
              email = #{sysUser.email},
          nick_name = #{sysUser.nickName},
          real_name = #{sysUser.realName},
                sex = #{sysUser.sex},
       create_where = #{sysUser.createWhere},
